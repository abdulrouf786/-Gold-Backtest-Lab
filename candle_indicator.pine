//@version=6
indicator("Gold 1-Min Candle Bias | Green / Red", overlay=true, max_labels_count=500)

// This is a rule-based estimate for the NEXT candle, not a guaranteed prediction.
// Signals are confirmed at the current candle close to avoid intrabar repainting.

emaFast = ta.ema(close, 9)
emaSlow = ta.ema(close, 21)
rsiValue = ta.rsi(close, 14)

isOneMinute = timeframe.isminutes and timeframe.multiplier == 1

bullTrend = emaFast > emaSlow
bearTrend = emaFast < emaSlow
bullCandle = close > open
bearCandle = close < open
bullMomentum = close > close[1]
bearMomentum = close < close[1]
bullRsi = rsiValue >= 55
bearRsi = rsiValue <= 45

greenBias = isOneMinute and barstate.isconfirmed and bullTrend and bullCandle and bullMomentum and bullRsi
redBias = isOneMinute and barstate.isconfirmed and bearTrend and bearCandle and bearMomentum and bearRsi

plot(emaFast, "EMA 9", color=color.aqua, linewidth=1)
plot(emaSlow, "EMA 21", color=color.orange, linewidth=1)

plotshape(greenBias, title="Next candle GREEN bias", style=shape.labelup, location=location.belowbar, color=color.green, text="NEXT\nGREEN", textcolor=color.white, size=size.small)
plotshape(redBias, title="Next candle RED bias", style=shape.labeldown, location=location.abovebar, color=color.red, text="NEXT\nRED", textcolor=color.white, size=size.small)

alertcondition(greenBias, title="Next Candle GREEN", message="Gold 1m indicator: GREEN bias for the next candle. This is an estimate, not a guarantee.")
alertcondition(redBias, title="Next Candle RED", message="Gold 1m indicator: RED bias for the next candle. This is an estimate, not a guarantee.")

var table info = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(info, 0, 0, isOneMinute ? "1M • Next-candle bias\nSignals on candle close" : "Switch chart to 1 minute", text_color=color.white, bgcolor=isOneMinute ? color.new(color.blue, 25) : color.new(color.red, 15))
